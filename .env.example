# AZAAM production/development environment template
# Copy to .env for local use. Never commit real secrets.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/azaam_medics_db

# Use a long, random value in production (minimum 32 characters).
JWT_SECRET=replace_with_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:5000

MAX_FILE_SIZE=10485760

# Development can use local storage. Production should use private Cloudflare R2.
# Set STORAGE_PROVIDER=r2 in Coolify once the R2 variables below are configured.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=local-documents

# Cloudflare R2 private object storage.
# Keep the bucket private and never expose these credentials to the frontend.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=azaam-private-attachments
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional generic S3-compatible provider settings.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Non-production database seed controls. `pnpm seed` refuses NODE_ENV=production
# and requires both explicit opt-in and a password of at least 12 characters.
ALLOW_DATABASE_SEED=false
SEED_PASSWORD=

# Optional SMTP configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
