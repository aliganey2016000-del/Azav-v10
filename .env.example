# AZAAM production/development environment template
# Copy to .env for local use. Never commit real secrets.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/azaam_medics_db

# Use a long, random value in production (minimum 32 characters).
JWT_SECRET=replace_with_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:5000

MAX_FILE_SIZE=10485760
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=local-documents

# Reserved for a future real object-storage provider. The current build fails
# closed if STORAGE_PROVIDER=s3 so files can never silently fall back to disk.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Non-production database seed controls. `pnpm seed` refuses NODE_ENV=production
# and requires both explicit opt-in and a password of at least 12 characters.
ALLOW_DATABASE_SEED=false
SEED_PASSWORD=

# Optional SMTP configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
